# 忽略虚拟环境及项目产生的临时文件
.venv/
.idea/
.claude/
.vscode/
__pycache__/
.DS_Store
.pytest_cache
备注笔记.txt
frontend/dist/
# 忽略log文件
logs/*
*.log
db.sqlite3
!logs/.gitkeep
# 忽略.env
.env
.env.dev
# .env 备份同样含密钥，禁止入库（2026-10-23 迁移非敏感项时产生）
.env.bak*
.env.*.bak*

# # 忽略所有 app/*/migrations/ 目录下的所有内容 (包括文件和子目录)
# apps/*/migrations/*
# # 使用否定模式，例外地跟踪 __init__.py 文件
# !apps/*/migrations/__init__.py

# 忽略media下的子目录及文件，但保留.gitkeep文件
media/allure-reports/*
!media/allure-reports/.gitkeep
media/allure-results/*
!media/allure-results/.gitkeep
media/requirement_docs/*
!media/requirement_docs/.gitkeep
media/ai_recording/*
!media/ai_recording/.gitkeep

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log

# 忽略临时调试脚本
check_*.py
!scripts/check_encoding.py
!scripts/check_configuration.py
debug_*.py
tmp_*.py

# 忽略知识库数据目录
knowledge-base/
knowledge-bases/

# 忽略backend下的重复apps目录
backend/apps/

# 忽略脚本输出文件
scripts/*.txt

# 本地 AI 助手每日流水（项目级约定统一维护在根目录 CODEBUDDY.md）
.codebuddy/memory/

# 根目录构建、部署与临时验证产物
build*.txt
build*.err
docker_*.err
docker_*.log
check_proj.txt
tmp_*.json
tmp_*.txt
test_fm.json
_cmp_*
_ws_db*.py
$null
webshare_test.html;

# 敏感凭证：墨刀登录 cookie，禁止入库
media/modao_cookies.json

# 前端构建产物 dump 与打包产物
_assets_dump/
_dist_assets_dump/
_ext/
_sync.tar
appium_workspace/
skills-dist/

# 本地临时验证文件
_chk_*.py
_ensure_*.py
_fe_build.txt
_nginx.conf
_proj_pages.txt
snapshot_*.png
vout.txt
logs.bat
watch.bat
watch_prod.bat
watch_prod.ps1
docker_cleanup_compact.bat
docker_cleanup_compact.ps1

# 墨刀样本素材（本地演示用，不入库）
media/modao_samples/

# 本地 AI 助手技能与临时脚本
.codebuddy/skills/
_fake_mig.py
nul; Write-Output cleaned

# 本地一次性脚本与过程笔记（根目录 _ 前缀，禁止入库）
/_*.py
/_*.txt
/_*.tar
/_*.jpg
/_*.json
/_*.out
/_*.sql
/_*.md
/_*.ps1
/_*.js
/_*.conf
/.codebuddy/memory/

# 本地临时验证目录与前端打包产物（2026-10-23 补）
/tmp/
frontend/_*.tar
frontend/_*.tmp.tar

# 本地数据库 dump（4GB 级，绝对禁止入库）
_db_backup/

# iOS 设备镜像 / 固件等本地大文件（10MB+ 二进制）
devimages/

# 2026-10-10 整理团队仓库时补：一次性调试残留与本地产物
/dist/
/generated-images/
/media/modao/probe_full/
/media/modao/clean_probe/
/migrate_folder.sql
/selfIdentity.plist
/tried
/scripts/ready
/fix-all.ps1
/fix-frontend-routes.sh
.debug_tmps/
frontend/_build_out.txt
frontend/_build_err.txt

# 2026-11-02 补：根目录 `_` 前缀的临时产物本就该忽略，但旧规则只覆盖了 .ps1/.js/.conf，
# 于是 _after_close.png / _probe_tab_shot.png / _c_ship.sh 这类一直显示为未跟踪。
/_*.png
/_*.sh
/_*.tar
/_*.log
/_*.txt

# 一次性调试脚本（排查用，跑完即弃，不进版本库）。
# 保留 scripts/ 下正式运维脚本（不带 _ 前缀的）。
/scripts/_*.py
/scripts/_*.sh
/scripts/_*.ps1
/scripts/_*.bat
/scripts/_*.txt

# 生产备份目录：含 3GB 级 DB dump，绝对禁止入库（但必须留在磁盘上）
/_backup_*/
/_db_backup/
